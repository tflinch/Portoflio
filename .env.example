# Anything prefixed with VITE_ is inlined into the client bundle by Vite and is
# PUBLIC. Never put a secret behind this prefix. That is exactly how the Elastic
# Email key ended up in assets/index-*.js.

# Public. The contact-form Lambda Function URL.
VITE_CONTACT_ENDPOINT=https://your-id.lambda-url.us-east-1.on.aws/

# SERVER-SIDE ONLY. Read by scripts/fetch-github-stats.mjs during the build and
# never shipped to the browser. Set this in the Amplify console, not in a file.
# Fine-grained token, public repositories read-only.
GITHUB_TOKEN=

# The following live in the Lambda's environment, NOT here and NOT in Amplify:
#   RESEND_API_KEY, CONTACT_FROM_EMAIL, CONTACT_TO_EMAIL, ALLOWED_ORIGIN
